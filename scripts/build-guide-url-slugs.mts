// Writes lib/guide-category-slugs.ts and lib/guide-article-slugs.ts: the address of every guide
// category and article in every language. Two files because breadcrumbs (on every page) need only
// the categories; the articles are loaded where an article address is built or read.
//
//   category  — from the tool's name in that language (t('tool.…')), e.g. pl "kompresja"… → "pdf-komprimieren" (de)
//   article   — from the article's title in that language
//   en        — the original English ids, so English addresses never change
//
// A slug that is already in the file is NEVER changed (a published address must stay put — a new
// title would otherwise move the page); the script only adds what is missing, e.g. for a new
// article or a new language. Run after adding either:  npx tsx scripts/build-guide-url-slugs.mts
import { writeFileSync, readFileSync, existsSync } from 'node:fs';
import { getAllArticles } from '../lib/guides';
import { locales, t, type Locale } from '../lib/i18n';
import { categoryTool } from '../lib/guide-category-tools';
import { getCategoryLabel } from '../lib/guide-categories';

const OUT_CAT = 'lib/guide-category-slugs.ts';
const OUT_ART = 'lib/guide-article-slugs.ts';

/** Languages written in Latin script: diacritics are dropped (ASCII addresses, as is usual for them). */
const LATIN = new Set(['pl', 'de', 'es', 'fr', 'it', 'pt', 'sv', 'no', 'is', 'tr', 'id', 'nl', 'da', 'ro', 'cs', 'vi']);
const SPECIAL: Record<string, string> = { ß: 'ss', ł: 'l', ø: 'o', æ: 'ae', œ: 'oe', þ: 'th', ð: 'd', đ: 'd', ı: 'i' };
const GERMAN: Record<string, string> = { ä: 'ae', ö: 'oe', ü: 'ue' };

export function slugify(text: string, locale: string): string {
  let s = text.normalize('NFC').toLocaleLowerCase(locale === 'tr' ? 'tr' : locale);
  if (LATIN.has(locale)) {
    if (locale === 'de') s = s.replace(/[äöü]/g, (c) => GERMAN[c]!);
    s = s.replace(/[ßłøæœþðđı]/g, (c) => SPECIAL[c]!);
    s = s.normalize('NFD').replace(/\p{M}/gu, '');
    s = s.replace(/[^a-z0-9]+/g, '-');
  } else {
    // Other scripts keep their letters (and the combining marks Devanagari, Thai… need).
    // (Zero-width joiners such as the Persian ZWNJ are not letters, so they become '-' too.)
    s = s.replace(/[^\p{L}\p{M}\p{N}]+/gu, '-');
  }
  return s.replace(/-+/g, '-').replace(/^-|-$/g, '');
}

/**
 * A very long title keeps its first whole words up to 64 characters. (A tighter limit for
 * non-Latin scripts cut Arabic and Persian titles off on a preposition, so all get the same.)
 */
export function shorten(slug: string, locale: string): string {
  const max = 64;
  if (slug.length <= max) return slug;
  const words = slug.split('-');
  let out = '';
  for (const w of words) {
    const next = out ? `${out}-${w}` : w;
    if (next.length > max) break;
    out = next;
  }
  return out || slug.slice(0, max);
}

type Table = Record<string, { category: Record<string, string>; articles: Record<string, Record<string, string>> }>;

async function existing(): Promise<Table> {
  const table: Table = {};
  if (existsSync(OUT_CAT)) {
    const { GUIDE_CATEGORY_SLUGS } = await import('../' + OUT_CAT);
    for (const [c, r] of Object.entries(GUIDE_CATEGORY_SLUGS as Record<string, Record<string, string>>)) (table[c] ??= { category: {}, articles: {} }).category = { ...r };
  }
  if (existsSync(OUT_ART)) {
    const { GUIDE_ARTICLE_SLUGS } = await import('../' + OUT_ART);
    for (const [c, arts] of Object.entries(GUIDE_ARTICLE_SLUGS as Record<string, Record<string, Record<string, string>>>)) {
      const e = (table[c] ??= { category: {}, articles: {} });
      for (const [slug, r] of Object.entries(arts)) e.articles[slug] = { ...r };
    }
  }
  return table;
}

const table = await existing();
let added = 0;
for (const a of getAllArticles()) {
  const entry = (table[a.category] ??= { category: {}, articles: {} });
  const art = (entry.articles[a.slug] ??= {});
  for (const l of locales) {
    if (!entry.category[l]) {
      const tool = categoryTool[a.category];
      entry.category[l] = l === 'en' ? a.category : slugify(tool ? t(`tool.${tool}`, l as Locale) : getCategoryLabel(a.category, l as Locale), l);
      added++;
    }
    if (!art[l]) {
      const full = l === 'en' ? a.slug : slugify((a.title as Record<string, string>)[l] || a.title.en, l);
      art[l] = shorten(full, l);
      if (art[l] !== full) console.log(`shortened ${l} ${a.slug}: ${full} → ${art[l]}`);
      added++;
    }
  }
}

const q = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
const obj = (r: Record<string, string>, ind: string) =>
  `{\n${Object.keys(r).sort().map((k) => `${ind}  ${/^[a-z]+$/.test(k) ? k : q(k)}: ${q(r[k]!)},`).join('\n')}\n${ind}}`;
const HEADER = `// GENERATED by scripts/build-guide-url-slugs.mts — an address that is published must not change:
// edit only by adding entries (the script never rewrites an existing one). Read through
// lib/guide-urls.ts / lib/guide-category-urls.ts.
`;

let cat = `${HEADER}
/** Category id (English) → language → address segment. */
export const GUIDE_CATEGORY_SLUGS: Record<string, Record<string, string>> = {\n`;
let art = `${HEADER}
/** Category id → article slug (English) → language → address segment. */
export const GUIDE_ARTICLE_SLUGS: Record<string, Record<string, Record<string, string>>> = {\n`;
for (const c of Object.keys(table).sort()) {
  const e = table[c]!;
  cat += `  ${q(c)}: ${obj(e.category, '  ')},\n`;
  art += `  ${q(c)}: {\n`;
  for (const slug of Object.keys(e.articles).sort()) art += `    ${q(slug)}: ${obj(e.articles[slug]!, '    ')},\n`;
  art += `  },\n`;
}
cat += '};\n';
art += '};\n';
for (const [file, src] of [[OUT_CAT, cat], [OUT_ART, art]] as const) {
  if (!existsSync(file) || readFileSync(file, 'utf8') !== src) writeFileSync(file, src);
}
console.log(`${OUT_CAT}, ${OUT_ART}: ${added} slug(s) added`);
