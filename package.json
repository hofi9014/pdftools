{
  "name": "pdftools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-tesseract-assets.mjs && node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-tesseract-assets.mjs && node scripts/copy-pdfjs-assets.mjs",
    "validate:guides": "npx --yes tsx scripts/validate-guides.ts",
    "test:regression": "npx --yes tsx tests/pdf-excel-regression.mts",
    "test:pptx": "npx --yes tsx tests/pptx-orchestrator-c3.mts",
    "test:url-to-pdf-ssrf": "npx --yes tsx tests/url-to-pdf-ssrf.mts",
    "test:ai-rate-limit-refund": "npx --yes tsx tests/ai-rate-limit-refund.mts",
    "test:dropbox-upload": "npx --yes tsx tests/dropbox-upload.mts",
    "test:proxy-csrf": "npx --yes tsx tests/proxy-csrf.mts",
    "test:office-to-pdf-entities": "npx --yes tsx tests/office-to-pdf-entities.mts",
    "test:edit-pdf-scale": "npx --yes tsx tests/edit-pdf-scale.mts",
    "test:redact-pdf-raster": "npx --yes tsx tests/redact-pdf-raster.mts",
    "test:convert-to-pdfa": "npx --yes tsx tests/convert-to-pdfa.mts",
    "test:guide-step-numbering": "npx --yes tsx tests/guide-step-numbering.tsx",
    "test:page-preview-count-i18n": "npx --yes tsx tests/page-preview-count-i18n.mts",
    "test:dropzone-keyboard-a11y": "npx --yes tsx tests/dropzone-keyboard-a11y.mts",
    "test:ocr-multi-file-pdf": "npx --yes tsx tests/ocr-multi-file-pdf.mts",
    "test:export-edited-pdf-scale": "npx --yes tsx tests/export-edited-pdf-scale.mts",
    "test:ocr-worker-cleanup": "npx --yes tsx tests/ocr-worker-cleanup.mts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "@upstash/redis": "^1.38.4",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.0"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "uuid": ">=11.1.1"
  }
}
